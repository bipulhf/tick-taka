{
  "name": "tick-taka",
  "private": true,
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "bun run --filter '*' typecheck && tsc -p scripts",
    "test": "bun run --filter '*' test && bun test ./scripts",
    "check": "biome check . && bun run typecheck && bun run test",
    "audit": "bun scripts/audit.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
