{
  "name": "tick-taka",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "check": "biome check . && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "typescript": "~5.9.3"
  }
}
