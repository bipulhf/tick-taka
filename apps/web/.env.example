# Where the browser sends API requests. Empty when the app is on the API's host; a full
# URL (https://api.example.com) when the API has its own host (list this site in the
# API's WEB_ORIGINS); /api in development, which Vite proxies to VITE_API_PROXY_TARGET.
VITE_API_URL=/api
VITE_API_PROXY_TARGET=http://localhost:3000
# The Google Cloud OAuth "Web application" client ID, the same one the phone uses.
# Its Authorised JavaScript origins must list this site (and http://localhost:5173).
VITE_GOOGLE_CLIENT_ID=
# Local development and screenshots only: sign in with a token from
# apps/api/scripts/demo.ts at /app/login?demoToken=<token>. Never set for real builds.
VITE_DEMO_SIGN_IN=
