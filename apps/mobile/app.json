{
  "expo": {
    "name": "Tick & Taka",
    "slug": "tick-taka",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ticktaka",
    "userInterfaceStyle": "automatic",
    "platforms": ["android"],
    "android": {
      "package": "com.mehedismathacademy.ticktaka",
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#FFF8EE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": ["POST_NOTIFICATIONS", "USE_BIOMETRIC", "VIBRATE", "RECORD_AUDIO"],
      "blockedPermissions": ["android.permission.READ_SMS", "android.permission.RECEIVE_SMS"],
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF8EE",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96,
          "dark": {
            "backgroundColor": "#16151C"
          }
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock Tick & Taka"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FFB547"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-image",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "SafeToSpend",
              "label": "Tick & Taka",
              "description": "Today at a glance: safe to spend, next up, and quick add",
              "previewImage": "./assets/images/widget-preview.png",
              "minWidth": "250dp",
              "minHeight": "130dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "expo-quick-actions",
      [
        "expo-audio",
        {
          "microphonePermission": "Tick & Taka uses the microphone so you can talk to Tiki."
        }
      ],
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
