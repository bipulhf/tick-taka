{
  "expo": {
    "name": "Tick & Taka",
    "slug": "tick-taka",
    "version": "1.3.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ticktaka",
    "userInterfaceStyle": "automatic",
    "platforms": ["android"],
    "android": {
      "package": "com.mehedismathacademy.tick",
      "versionCode": 5,
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#FFF8EE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": ["POST_NOTIFICATIONS", "USE_BIOMETRIC", "VIBRATE", "RECORD_AUDIO"],
      "blockedPermissions": ["android.permission.READ_SMS", "android.permission.RECEIVE_SMS"],
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF8EE",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96,
          "dark": {
            "backgroundColor": "#16151C"
          }
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock Tick & Taka"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FFB547"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-image",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "SafeToSpend",
              "label": "Today",
              "description": "Tick your top three, mark the next thing done, see what's safe to spend",
              "previewImage": "./assets/images/widget-today.png",
              "minWidth": "250dp",
              "minHeight": "130dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "widgetFeatures": "reconfigurable"
            },
            {
              "name": "QuickLog",
              "label": "Quick log",
              "description": "Your usual spends as chips: one tap logs it",
              "previewImage": "./assets/images/widget-quick-log.png",
              "minWidth": "250dp",
              "minHeight": "50dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "resizeMode": "horizontal",
              "updatePeriodMillis": 1800000,
              "widgetFeatures": "reconfigurable"
            },
            {
              "name": "SafeSpend",
              "label": "Safe to spend",
              "description": "Today's number, what's spent and days left",
              "previewImage": "./assets/images/widget-safe-spend.png",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "widgetFeatures": "reconfigurable"
            },
            {
              "name": "Habits",
              "label": "Habits",
              "description": "Habit rings: tap one to count it for today",
              "previewImage": "./assets/images/widget-habits.png",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "widgetFeatures": "reconfigurable"
            },
            {
              "name": "Bills",
              "label": "Bills due",
              "description": "What's still to pay, with Paid right on the home screen",
              "previewImage": "./assets/images/widget-bills.png",
              "minWidth": "250dp",
              "minHeight": "130dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "widgetFeatures": "reconfigurable"
            },
            {
              "name": "Focus",
              "label": "Focus",
              "description": "Start or stop a focus period on your next task",
              "previewImage": "./assets/images/widget-focus.png",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "widgetFeatures": "reconfigurable"
            },
            {
              "name": "ThisMonth",
              "label": "This month",
              "description": "Money in and out, budgets used and the top category",
              "previewImage": "./assets/images/widget-this-month.png",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "widgetFeatures": "reconfigurable"
            },
            {
              "name": "Tasks",
              "label": "Tasks list",
              "description": "Earlier and today's tasks to tick, in a list that scrolls",
              "previewImage": "./assets/images/widget-tasks.png",
              "minWidth": "250dp",
              "minHeight": "180dp",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "widgetFeatures": "reconfigurable"
            }
          ]
        }
      ],
      "expo-quick-actions",
      [
        "expo-audio",
        {
          "microphonePermission": "Tick & Taka uses the microphone so you can talk to Tiki."
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-background-task"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
