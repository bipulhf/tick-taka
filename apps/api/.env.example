# Loopback (the default) so only Nginx can reach the API. Use 0.0.0.0 only to test
# from a phone on your Wi-Fi.
HOST=127.0.0.1
# 3000 locally (the emulator reaches http://10.0.2.2:3000). On the server use 3003,
# the port deploy/nginx-tick-taka.conf proxies to.
PORT=3000
# On the server behind Nginx: believe its X-Real-IP header for the sign-in limit.
# Leave false when nothing proxies the API.
TRUST_PROXY=false
# Each user gets their own SQLite file in users/ next to this; this file is the
# single-user database from before Google sign-in, which OWNER_EMAIL inherits.
DB_PATH=./data/app.db
# Optional: copies backups off this disk after each night's run (README › Backups)
BACKUP_OFFSITE_CMD=
# Google Cloud OAuth "Web application" client ID (the phone requests tokens for it)
GOOGLE_CLIENT_IDS=
# Your Google email: takes over the data in DB_PATH on your first sign-in
OWNER_EMAIL=
# bun -e 'console.log(crypto.randomUUID() + crypto.randomUUID())'
JWT_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL_FAST=gpt-6-luna
OPENAI_MODEL_SMART=gpt-6-luna
OPENAI_MODEL_TRANSCRIBE=gpt-4o-mini-transcribe
# Most AI may cost each user other than OWNER_EMAIL per month, in micro-dollars
# (2000000 = $2; 0 = no limit). The owner is never limited.
AI_USER_MONTHLY_CAP_MICROS=2000000
# Named on the public home, privacy and terms pages (/, /privacy, /terms)
SITE_OPERATOR=Mehedi's Math Academy
CONTACT_EMAIL=
